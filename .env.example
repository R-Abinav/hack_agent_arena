# LLM Configuration
LLM_PROVIDER=ollama   # ollama | openai | anthropic | gemini
MODEL=qwen3.5:9b      # model name (e.g., claude-3-5-sonnet-20240620, gemini-1.5-pro, etc.)

# API Keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=       # Only if using OpenAI directly (not local Ollama)

# Ollama Config (if provider is ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# HydraDB Config (for persistent memory)
USE_HYDRA=true
HYDRA_DB_API_KEY=

# AppWorld Config
APPWORLD_EXPERIMENT=silvanites
APPWORLD_DATASET=dev
MAX_TASKS=0
MAX_INTERACTIONS=30
